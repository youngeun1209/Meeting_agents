#!/bin/bash
# App executable — delegates to Terminal, does NOT run the app itself.
#
# WHY: an adhoc-signed, non-notarized .app launched from Finder cannot reliably
# hold a TCC grant to READ its own folder under ~/Documents. Adding it to Full
# Disk Access does not stick because the app has no stable code identity (adhoc =
# cdhash changes on every edit; TCC has no record to match). That is exactly the
# "needs permission to use its folder" dialog that never clears.
#
# Fix: don't read/run the project files here at all. Hand STT.command to `open`,
# which LaunchServices opens with Terminal. Terminal HAS a stable identity and the
# user's folder access (running `python gui.py` from Terminal already works), so
# the app starts under Terminal's grant. This script only computes a path.
LOG="/tmp/meeting_stt_launch.log"; : > "$LOG"
echo "=== $(/bin/date) — delegating to Terminal ===" >> "$LOG"

# Ensure the standard tool locations are present (Finder gives a bare PATH).
export PATH="/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

HERE="$(cd "$(dirname "$0")" && pwd)"     # .../Meeting STT.app/Contents/MacOS
ROOT="$(cd "$HERE/../../.." && pwd)"      # the folder that holds the .app
CMD="$ROOT/STT.command"
echo "ROOT=$ROOT" >> "$LOG"
echo "delegating: open $CMD" >> "$LOG"

if [ ! -e "$CMD" ]; then
    # We may not be able to stat it under TCC; try open anyway, but note it.
    echo "note: STT.command not visible from here (TCC); attempting open regardless" >> "$LOG"
fi

exec /usr/bin/open "$CMD"
